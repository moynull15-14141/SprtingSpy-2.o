# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================
# PHASE 1 — AUTHENTICATION & STAFF IDENTITY
# See server/auth.ts, server/session.ts, server/password.ts, and
# the archived project notes ("Phase 1 — Authentication & Staff Identity").
#
# Real email+password login now exists (POST /api/auth/login) with
# server-side sessions (opaque random cookie, no client-side secret needed
# to sign it — see server/session.ts for why). The Phase 0.1
# DEV_USER_ROLE/DEV_AUTH_TOKEN/VITE_DEV_AUTH_TOKEN variables are GONE and no
# longer read anywhere — do not set them expecting any effect.
#
# Every account seeded before this phase (src/data/seedData.ts) is
# migrated by the explicit legacy data import to have a password: local dev
# default password: "ChangeMe123!" (see LEGACY_SEED_DEFAULT_PASSWORD in
# server.ts). Log in as e.g. editor-in-chief@sportingspy.com with that
# password to test Admin flows. This is a LOCAL DEMO DEFAULT ONLY — never
# used for accounts created after this phase (POST /api/users requires a
# real password at creation time).
# ============================================================

# AUTH_MODE: leave unset or "development" for local work. "production" is
# now a supported boot mode (real auth exists) — it is refused ONLY if
# DEV_LOGIN_BYPASS=true is also set, since that combination would mean a
# "production" server grants a fixed identity to any request with no
# session at all.
AUTH_MODE="development"

# DEV_LOGIN_BYPASS: disabled by default. When "true" (and AUTH_MODE is not
# "production"), any request with NO session cookie is treated as a fixed
# configured identity (DEV_BYPASS_USER_ID below, or a default Reader) —
# purely to let scripted/automated local tests skip a login round-trip. It
# NEVER overrides a real session; logging in always takes priority. Do not
# enable this anywhere reachable by the public internet.
DEV_LOGIN_BYPASS="false"

# DEV_BYPASS_USER_ID: optional. If DEV_LOGIN_BYPASS is enabled, pins the
# bypass identity to a specific seeded user id (e.g. "user-admin-1") instead
# of a generic Reader.
DEV_BYPASS_USER_ID=""

# ============================================================
# PHASE 2 — LOCAL POSTGRESQL MIGRATION
# See prisma/schema.prisma and server/db.ts.
#
# The app now persists to PostgreSQL via Prisma instead of data/db.json.
# data/db.json (the old JSON store) is no longer in the repository.
# ============================================================

# DATABASE_URL: connection string for your LOCAL PostgreSQL instance.
# Setup (Windows, PostgreSQL already installed as a service):
#   1. Open psql/pgAdmin as a user who can create roles (e.g. postgres).
#   2. CREATE ROLE sportingspy WITH LOGIN PASSWORD 'choose-a-password' CREATEDB;
#   3. CREATE DATABASE sportingspy OWNER sportingspy;
#   4. Set DATABASE_URL below to match, then run:
#        npm run db:migrate       (applies prisma/migrations to your DB)
#        npm run db:migrate-data  (historical one-time import; needs data/db.json restored from the archive)
# NEVER commit this value with a real password — this file only holds a
# placeholder. Your actual value belongs in a local, gitignored `.env`.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sportingspy?schema=public"

# ============================================================
# PHASE 2.1 — DATABASE SAFETY
# See DATABASE_OPERATIONS.md for the full recovery/backup baseline and the
# exact list of commands that must NEVER be run against a database holding
# real data: `prisma migrate reset`, `prisma db push --force-reset`,
# `DROP DATABASE`, `DROP SCHEMA ... CASCADE`. Use `npm run db:migrate:deploy`
# (never creates a new migration, never resets anything) to safely reproduce
# the existing schema on a fresh database instead.
# ============================================================

# ALLOW_DESTRUCTIVE_DB_OPS: leave unset/false. server/dbSafety.ts uses this
# to refuse running the JSON->Postgres importer (npm run db:migrate-data)
# against a DATABASE_URL that doesn't look like a local dev database. Only
# set to "true" if you deliberately intend to run that script against a
# non-local target and understand the consequences.
ALLOW_DESTRUCTIVE_DB_OPS="false"

# ============================================================
# PHASE A — LAUNCH FEATURE FLAGS (see server/features.ts)
# Spec v1.1 §2.2 lists reader accounts and comments as NOT required at
# launch. Their code and stored data are preserved; they are switched off
# unless explicitly enabled here. The server enforces these flags — the
# browser only receives a read-only copy for display.
# ============================================================

# ENABLE_READER_ACCOUNTS: "true" re-enables Reader-role logins, the Reader
# role in staff management, and the account-area language switch.
ENABLE_READER_ACCOUNTS="false"

# ENABLE_COMMENTS: "true" re-enables public comments and moderation.
ENABLE_COMMENTS="false"

# ============================================================
# SERVER / DEPLOYMENT (read by server/deployment.ts)
# One Node process (server.ts) serves the API and renders every page with
# Next.js. Production refuses to start without ALLOWED_ORIGIN and a build.
# ============================================================

# NODE_ENV: "production" in production (npm run start:production sets it).
# APP_ENV: development, staging or production. Staging runs the production
# build with noindex/robots protection and no IndexNow notifications. Use a
# separate database, media bucket and credentials for each environment.
APP_ENV="development"
# PORT / HOST: listening port and bind IP (defaults 3000 / 0.0.0.0).
PORT="3000"
HOST="0.0.0.0"

# ALLOWED_ORIGIN: the public browser-facing origin, e.g.
# "https://www.sportingspy.com". Required in production. PHASE B also uses it
# as the base of every canonical URL, og:url and JSON-LD URL, so it must be
# the real public origin (no path, no trailing slash).
ALLOWED_ORIGIN=""

# PHASE N: hosts of the OLD site whose absolute URLs the migration sheet
# accepts as paths on this site (comma-separated). Default: the current
# WordPress site's hosts. Any other host in a sheet row is refused.
# The canonical production host is https://www.sportingspy.com. Configure
# apex/HTTP redirects at the proxy before launch; migration remains on hold.
# LEGACY_SITE_HOSTS="www.sportingspy.com,sportingspy.com"

# PHASE P (diagnostics only): PRISMA_QUERY_LOG="true" prints one line per
# database query so performance audits can count/time them. Never in production.
# PRISMA_QUERY_LOG="false"

# TRUST_PROXY: "false", or the explicit IP/CIDR of the reverse proxy in
# front of this server (needed for HTTPS detection behind TLS termination).
TRUST_PROXY="false"

# ============================================================
# PHASE C — MEDIA LIBRARY STORAGE (server/media/storage.ts)
# ============================================================
# MEDIA_STORAGE_PROVIDER: "local", "s3", or "r2" (same S3-compatible adapter).
# Other values fail at startup instead of silently storing locally.
MEDIA_STORAGE_PROVIDER="local"
# MEDIA_LOCAL_DIR: where uploads and generated sizes are written (served at
# /media). Must be persistent storage and included in backups.
MEDIA_LOCAL_DIR="storage/media"
# MEDIA_PUBLIC_BASE_URL: optional base for media URLs (e.g. a CDN in front of
# the storage). Default "/media".
MEDIA_PUBLIC_BASE_URL=""

# PHASE J/T.1: required when MEDIA_STORAGE_PROVIDER=s3 or r2. Keep actual credentials
# in your deployment secret store; never in Git. Public base is required,
# HTTPS, and embedded at build time (rebuild when changing media domains).
MEDIA_S3_BUCKET=""
MEDIA_S3_REGION=""
# Optional HTTPS origin; for R2 use the account's S3 endpoint and region auto.
MEDIA_S3_ENDPOINT=""
MEDIA_S3_ACCESS_KEY_ID=""
MEDIA_S3_SECRET_ACCESS_KEY=""
# Optional token when using temporary S3 credentials.
MEDIA_S3_SESSION_TOKEN=""
MEDIA_S3_FORCE_PATH_STYLE="false"
# R2: set provider=r2, region=auto, its HTTPS S3 endpoint, and force path
# style=true. Set MEDIA_PUBLIC_BASE_URL to the separate public custom domain.
# The account S3 endpoint is private API access, never the public image URL.
# PROFILE_IMAGE_ALLOWED_ORIGINS: optional comma-separated HTTPS origins for
# staff/author image URLs from other hosts. The configured media origin and
# images.unsplash.com are already accepted. Unknown hosts are refused on save
# so a URL cannot be saved while production CSP blocks its image request.
PROFILE_IMAGE_ALLOWED_ORIGINS=""

# Production: AUTH_MODE=production, APP_ENV=production (or staging),
# DEV_LOGIN_BYPASS=false, ALLOW_DESTRUCTIVE_DB_OPS=false, and HTTPS origin.
# SHADOW_DATABASE_URL must stay unset. Startup never runs migrations.
# Rotate legacy credentials explicitly: npm run users:set-password -- <email>

# ── PHASE R (all optional; leave unset when the feature is not used) ──
# Encrypts staff TOTP (two-factor) secrets. REQUIRED in production before anyone enables 2FA (32+ random characters).
# TOTP_ENCRYPTION_KEY=
# Password reset e-mails via Resend's HTTP API. Without these, only Admin-issued reset links work.
# RESEND_API_KEY=
# MAIL_FROM="SportingSpy <no-reply@example.com>"
# Google Search Console import: the service-account JSON (one line). Also set Settings → Search Console property.
# GOOGLE_SEARCH_CONSOLE_CREDENTIALS=
# Bing Webmaster Tools import. Also set Settings → Bing site URL.
# BING_WEBMASTER_API_KEY=
# Public data cache lifetime in seconds (default 60; 0 disables the cache).
# PUBLIC_CACHE_TTL_SECONDS=60
