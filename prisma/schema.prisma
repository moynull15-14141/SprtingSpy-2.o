// SportingSpy PostgreSQL Schema — PHASE 2
// ==========================================
// Modeled directly from the actual runtime shapes in data/db.json and the
// TypeScript domain types in src/types/index.ts — not from generic CMS
// assumptions. See PROJECT_BRAIN.md "Phase 2" for the migration writeup.
//
// Design notes:
// - Every model keeps its existing string `id` scheme (e.g. "sport-tennis",
//   "art-rg-2027-schedule") as the Prisma @id, so existing IDs migrate
//   unchanged and the API can keep returning the same id values.
// - Relationships use the SAME natural keys the current JSON code already
//   uses to join records (sportSlug, eventSlug, year) rather than inventing
//   surrogate foreign keys the app doesn't have today — this preserves the
//   actual current behavior/business rules exactly while still getting real
//   Postgres foreign-key + unique-constraint enforcement.
// - Nested structures that the app only ever reads/writes as a whole blob
//   (SEO metadata, quick facts, defending champions, structured tables,
//   references, featured/edition-year arrays) are stored as native Postgres
//   array or Json columns rather than being split into extra tables the
//   application never queries relationally — avoids unnecessary models.
// - MediaItem, AdSlotConfig, RedirectRule, AuditLog remain standalone,
//   matching their current disconnected/denormalized behavior in server.ts.

generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums (mirrors the TypeScript unions in src/types/index.ts) ──

enum Role {
  Admin
  Editor
  Author
  Reader
}

enum UserStatus {
  active
  inactive
}

enum ArticleStatus {
  draft
  preview
  scheduled
  published
  archived
}

enum ArticleReviewStatus {
  not_required
  draft
  in_review
  changes_requested
  approved
}

// Spec v1.1 §4.3. Phase A renamed "ongoing" -> "active" and added
// "archived" (migration 20260927000000_phase_a_foundation).
enum EditionStatus {
  upcoming
  active
  completed
  archived
}

enum CommentStatus {
  pending
  approved
  rejected
}

// ArticleType and MediaCreationType are deliberately plain, app-validated
// String columns rather than Prisma enums. Both TS unions contain values
// with spaces/ampersands ("Rules & Format", "How to Watch") that
// cannot be Prisma enum identifiers without an @map translation layer on
// every single read/write call site across server.ts. That translation
// buys no real integrity benefit here (these fields were never DB-enforced
// in the JSON version either — server.ts already validates/defaults them at
// the application layer), so a String column preserves the exact existing
// values and behavior with zero added translation risk.

enum AuditEntityType {
  Sport
  Event
  Edition
  Article
  Comment
  Setting
  User
  Author
  Redirect
  Faq
  ContactMessage
  // PHASE R
  ArticleType
  Migration
  Media
  Integration
  // PHASE PAGES
  Page
}

// PHASE R (Spec v2.0 §9.3 "editable and expandable"): the Article Type list
// lives in the database. `name` is the identity stored on Article.articleType
// (FK, ON UPDATE/DELETE RESTRICT): a type in use can be deactivated but never
// renamed or deleted, so existing articles keep their exact type. System
// types are the seeded specification types. `seoProfile` selects the
// type-aware SEO checks a custom type inherits; `schemaType` selects the
// Article/NewsArticle/BlogPosting structured-data type.
model ArticleType {
  id          String   @id
  name        String   @unique
  slug        String   @unique
  description String   @default("")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  schemaType  String   @default("Article")
  seoProfile  String   @default("general")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles Article[]

  @@index([isActive, sortOrder])
}

// ── Core domain hierarchy: Sport -> Event -> Edition -> Article ──

model Sport {
  id               String   @id
  slug             String   @unique
  name             String
  tagline          String
  description      String
  order            Int
  isVisible        Boolean  @default(true)
  featuredEventIds String[] @default([])
  colorTheme       String?
  heroImage        String?
  seo              Json
  // E2: optional validated definitions/terminology. NULL resolves to generic configuration.
  eventConfiguration Json?
  // Icon from the curated set in src/config/sportIcons.ts; null = suggested from the name.
  icon             String?
  // PHASE R: the sport image/logo as a Media Library item (heroImage keeps the resolved URL).
  heroMediaId      String?
  // PHASE R: FAQPage structured data for this sport's FAQ is opt-in (validated before output).
  faqSchemaEnabled Boolean  @default(false)

  events    SportEvent[]
  articles  Article[]
  heroMedia MediaItem?   @relation("SportHeroMedia", fields: [heroMediaId], references: [id], onDelete: Restrict)
  faqs      FaqEntry[]

  @@index([isVisible])
  @@index([heroMediaId])
}

model SportEvent {
  id                 String  @id
  sportSlug          String
  slug               String
  name               String
  shortName          String
  description        String
  history            String?
  frequency          String?
  defaultVenue       String?
  defaultLocation    String?
  currentEditionYear Int?
  allEditionYears    Int[]   @default([])
  featured           Boolean @default(false)
  isVisible          Boolean @default(true)
  featuredImage      String?
  officialSourceUrl  String?
  eventType          String?
  seo                Json
  // E2: values only; definitions live on Sport.eventConfiguration.
  sportSpecificValues Json?
  // PHASE R: other names readers search for (one per line, e.g. "Roland Garros").
  alternativeNames    String  @default("")
  // PHASE R: Media Library relation for featuredImage (URL kept as the resolved value).
  featuredMediaId     String?
  faqSchemaEnabled    Boolean @default(false)
  // PHASE M: weighted full-text document maintained by PostgreSQL (migration
  // 20261009090000_phase_m_event_search). Never written by the application;
  // read only through server/services/search.
  searchVector        Unsupported("tsvector")? @default(dbgenerated("(((setweight(to_tsvector('english'::regconfig, ((((COALESCE(name, ''::text) || ' '::text) || COALESCE(\"shortName\", ''::text)) || ' '::text) || COALESCE(\"alternativeNames\", ''::text))), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, ((((replace(COALESCE(\"sportSlug\", ''::text), '-'::text, ' '::text) || ' '::text) || replace(COALESCE(slug, ''::text), '-'::text, ' '::text)) || ' '::text) || COALESCE(\"eventType\", ''::text))), 'B'::\"char\")) || setweight(to_tsvector('english'::regconfig, ((((COALESCE(\"defaultVenue\", ''::text) || ' '::text) || COALESCE(\"defaultLocation\", ''::text)) || ' '::text) || COALESCE(frequency, ''::text))), 'C'::\"char\")) || setweight(to_tsvector('english'::regconfig, ((COALESCE(description, ''::text) || ' '::text) || COALESCE(history, ''::text))), 'D'::\"char\"))"))

  sport         Sport          @relation(fields: [sportSlug], references: [slug])
  editions      EventEdition[]
  faqs          FaqEntry[]
  featuredMedia MediaItem?     @relation("EventFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: Restrict)

  // Matches the exact uniqueness the app already enforces in POST /api/events
  // ("Event '<slug>' already exists under sport '<sportSlug>'").
  @@unique([sportSlug, slug])
  @@index([sportSlug])
  @@index([featuredMediaId])
  @@index([searchVector], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], map: "SportEvent_name_trgm_idx", type: Gin)
  @@index([alternativeNames(ops: raw("gin_trgm_ops"))], map: "SportEvent_alternativeNames_trgm_idx", type: Gin)
}

model EventEdition {
  id                 String        @id
  eventSlug          String
  sportSlug          String
  year               Int
  title              String
  startDate          String?
  endDate            String?
  venue              String?
  location           String?
  status             EditionStatus @default(upcoming)
  quickFacts         Json          @default("[]")
  prizeMoneyTotal    String?
  defendingChampions Json?
  qualificationInfo  String?
  participantsCount  Int?
  officialSourceUrl  String?
  description        String
  featuredImage      String?
  seo                Json
  // PHASE R: Media Library relation for featuredImage; opt-in FAQPage markup.
  featuredMediaId    String?
  faqSchemaEnabled   Boolean       @default(false)
  // PHASE M: weighted full-text document maintained by PostgreSQL; lets an
  // Edition's title, year or venue lead search to its Event.
  searchVector       Unsupported("tsvector")? @default(dbgenerated("(((setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, (year)::text), 'B'::\"char\")) || setweight(to_tsvector('english'::regconfig, ((COALESCE(venue, ''::text) || ' '::text) || COALESCE(location, ''::text))), 'C'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(description, ''::text)), 'D'::\"char\"))"))

  event         SportEvent @relation(fields: [sportSlug, eventSlug], references: [sportSlug, slug])
  articles      Article[]
  featuredMedia MediaItem? @relation("EditionFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: Restrict)
  faqs          FaqEntry[]

  // Matches POST /api/editions's exact collision check.
  @@unique([sportSlug, eventSlug, year])
  @@index([sportSlug, eventSlug])
  @@index([featuredMediaId])
  @@index([searchVector], type: Gin)
}

model Article {
  id                 String        @id
  slug               String
  title              String
  subtitle           String?
  sportSlug          String
  eventSlug          String?
  editionYear        Int?
  articleType        String        @default("Event Guide")
  excerpt            String
  content            String
  featuredImage      String
  authorId           String
  publishedAt        DateTime
  updatedAt          DateTime?
  scheduledFor       DateTime?
  status             ArticleStatus @default(draft)
  reviewStatus       ArticleReviewStatus @default(not_required)
  reviewerId         String?
  reviewComment      String?
  reviewSubmittedAt  DateTime?
  reviewDecidedAt    DateTime?
  reviewVersion      Int @default(0)
  reviewer           User? @relation("ArticleReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  readingTimeMinutes Int
  featured           Boolean       @default(false)
  tables             Json?
  references         Json?
  seo                Json
  // PHASE C: rich-text body (validated TipTap/ProseMirror JSON document).
  // When null the legacy plain-text `content` is rendered. `content` is
  // always kept as the plain-text projection (search, reading time).
  body               Json?
  // PHASE C: the featured image as a Media Library relation. `featuredImage`
  // (URL) is kept as the resolved fallback for legacy/URL-only images.
  featuredMediaId    String?
  // PHASE D: when an editor last confirmed the content is still accurate
  // (freshness review). Never changes updatedAt.
  reviewedAt         DateTime?
  // PHASE R: FAQPage structured data for this article's FAQ is opt-in.
  faqSchemaEnabled   Boolean       @default(false)
  // PHASE E: weighted full-text search document. A STORED generated column
  // computed by PostgreSQL from title/subtitle/type/sport/event/keywords/
  // excerpt/content (see migration 20260929090000_phase_e_search). Never
  // written by the application; read only through server/services/search.
  searchVector       Unsupported("tsvector")? @default(dbgenerated("(((setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, ((((((((COALESCE(subtitle, ''::text) || ' '::text) || COALESCE(\"articleType\", ''::text)) || ' '::text) || replace(COALESCE(\"sportSlug\", ''::text), '-'::text, ' '::text)) || ' '::text) || replace(COALESCE(\"eventSlug\", ''::text), '-'::text, ' '::text)) || ' '::text) || COALESCE(((seo -> 'keywords'::text))::text, ''::text))), 'B'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(excerpt, ''::text)), 'C'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(content, ''::text)), 'D'::\"char\"))"))

  sport         Sport          @relation(fields: [sportSlug], references: [slug])
  author        Author         @relation(fields: [authorId], references: [id])
  edition       EventEdition?  @relation(fields: [sportSlug, eventSlug, editionYear], references: [sportSlug, eventSlug, year])
  featuredMedia MediaItem?     @relation("ArticleFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: Restrict)
  type          ArticleType    @relation(fields: [articleType], references: [name], onDelete: Restrict, onUpdate: Restrict)
  bodyMedia     ArticleMedia[]
  comments      Comment[]
  faqs          FaqEntry[]

  // NOTE: true slug-collision scoping (sportSlug+eventSlug+editionYear+slug,
  // with JS `undefined === undefined` semantics for general articles) is
  // enforced in application code (server.ts), not by a DB unique constraint
  // here — Postgres treats NULL columns as distinct in unique constraints,
  // which would NOT match the app's existing JS equality behavior for
  // general (no event/edition) articles. See server.ts's article creation
  // handler for the actual collision check, preserved as-is.
  @@index([sportSlug])
  @@index([status])
  @@index([status, scheduledFor])
  @@index([reviewStatus, reviewerId])
  @@index([slug])
  @@index([authorId])
  @@index([featuredMediaId])
  @@index([status, publishedAt])
  @@index([articleType])
  @@index([sportSlug, eventSlug, editionYear, status, publishedAt])
  @@index([searchVector], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], map: "Article_title_trgm_idx", type: Gin)
  @@index([excerpt(ops: raw("gin_trgm_ops"))], map: "Article_excerpt_trgm_idx", type: Gin)
}

// PHASE C: images referenced inside an article body (usage tracking).
// Maintained by the server on every article save.
model ArticleMedia {
  articleId String
  mediaId   String

  article Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media   MediaItem @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([articleId, mediaId])
  @@index([mediaId])
}

// ── Authors & Staff Identity (Phase 1 relationship preserved) ──

model Author {
  id           String  @id
  slug         String  @unique
  name         String
  roleTitle    String
  bio          String
  avatar       String
  twitter      String?
  email        String?
  articleCount Int?    @default(0)

  // Phase 1: links a public byline to the staff account permitted to edit
  // its articles. Nullable — many Author profiles have no staff login
  // (freelance/legacy credits). No onDelete cascade: deleting a User must
  // not delete their Author profile/byline (matches current app behavior,
  // which never deletes Authors when a User is deleted).
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  articles Article[]
}

model User {
  id           String     @id
  name         String
  email        String     @unique
  role         Role
  avatar       String
  joinedAt     DateTime
  updatedAt    DateTime?
  status       UserStatus @default(active)
  // Server-only. Never selected into any API response — see
  // server/db/users.ts's sanitizeUser() projection.
  passwordHash String

  // PHASE R: optional TOTP second factor (RFC 6238). The secret is stored
  // encrypted (server/totp.ts) and never leaves the server after enrolment.
  totpSecret    String?
  totpEnabledAt DateTime?

  authorProfile Author?
  assignedReviews Article[] @relation("ArticleReviewer")
  sessions      Session[]
  passwordResets PasswordResetToken[]

  @@index([email])
  @@index([role, status])
  // PHASE AUTOSAVE: editor working copies started by this user.
  editorDrafts EditorDraft[]
}

// Phase 1: opaque-token sessions. Deleting the user cascades to their
// sessions, matching the existing manual `db.sessions = db.sessions.filter(...)`
// behavior on user deletion in server.ts exactly.
model Session {
  id        String   @id
  userId    String
  createdAt DateTime
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// PHASE R: single-use password reset tokens. Only a SHA-256 hash of the token
// is stored; the token itself exists only in the reset link. `createdBy` is
// "self" (requested from the sign-in screen) or the Admin user id that
// generated the link. Using a token revokes all of the user's sessions.
model PasswordResetToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  createdAt DateTime
  expiresAt DateTime
  usedAt    DateTime?
  createdBy String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ── Comments (denormalized author fields preserved exactly as the JSON
// version stores them — no live join to User, so a comment keeps showing
// its author's name/avatar/role even if that User is later deleted, exactly
// matching current behavior) ──

model Comment {
  id         String        @id
  articleId  String
  userId     String
  userName   String
  userAvatar String?
  userRole   Role?
  content    String
  createdAt  DateTime
  status     CommentStatus @default(pending)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([status])
}

// ── Standalone collections (no relations in the current app — preserved
// disconnected, matching existing behavior exactly) ──

model MediaItem {
  id           String            @id
  title        String
  url          String
  altText      String
  caption      String?
  credit       String?
  source       String?
  license      String?
  creationType String  @default("SportingSpy Original")
  uploadedAt   DateTime
  fileSize     String?
  dimensions   String?

  // PHASE C: stored file + processing results (null for legacy URL-only items).
  storageKey      String?
  filename        String?
  mimeType        String?
  width           Int?
  height          Int?
  sizeBytes       Int?
  variants        Json?
  // PHASE C: Spec v1.1 §16 metadata.
  aiTool          String?
  humanEditing    String?
  copyrightReview String    @default("pending")
  updatedAt       DateTime?
  // PHASE R: SHA-256 of the uploaded original, for duplicate detection.
  contentHash     String?

  featuredIn     Article[]      @relation("ArticleFeaturedMedia")
  bodyUsages     ArticleMedia[]
  sportHeroes    Sport[]        @relation("SportHeroMedia")
  eventImages    SportEvent[]   @relation("EventFeaturedMedia")
  editionImages  EventEdition[] @relation("EditionFeaturedMedia")
  pageOgImages   Page[]         @relation("PageOgMedia")

  @@index([contentHash])
}

model AdSlotConfig {
  id                   String  @id
  name                 String
  placementDescription String
  enabled              Boolean @default(false)
  sponsorName          String?
  bannerText           String?
  linkUrl              String?
  dimensions           String
  // PHASE F: who fills the slot. "house" = the sponsor/partner banner above
  // (no third party); "adsense" = a Google AdSense unit, rendered only with
  // advertising consent. providerSlotId = the provider's ad unit ID.
  provider             String  @default("house")
  providerSlotId       String?
  creativeId           String?
  creative             AdCreative? @relation(fields: [creativeId], references: [id], onDelete: Restrict)
  creativeAlt          String?
  creativeFit          String @default("contain")
}

model AdCreative {
  id              String @id
  title           String
  url             String
  storageKey      String @unique
  kind            String
  mimeType        String
  width           Int
  height          Int
  sizeBytes       Int
  durationSeconds Float?
  createdAt       DateTime @default(now())
  slots           AdSlotConfig[]
}

model RedirectRule {
  id         String    @id
  // PHASE C: one rule per source path (stored without trailing slash).
  sourceUrl  String    @unique
  targetUrl  String
  statusCode Int
  createdAt  DateTime
  isActive   Boolean   @default(true)
  // PHASE C: "manual" or "article-slug" (created automatically on URL change).
  origin     String    @default("manual")
  notes      String?
  updatedAt  DateTime?

  @@index([isActive])
}

// PHASE D: SEO rules engine. Rule logic lives in code (server/seo/rules.ts),
// keyed by `key`; everything an editor may tune without a rebuild —
// enabled, severity, applicable article types, thresholds/term lists — is here.
model SeoRule {
  id           String   @id
  key          String   @unique
  name         String
  description  String
  category     String
  targetType   String
  articleTypes String[] @default([])
  severity     String
  enabled      Boolean  @default(true)
  config       Json
  version      Int      @default(1)
  createdAt    DateTime
  updatedAt    DateTime
}

// PHASE D: one SEO Intelligence scan (admin-triggered). Findings are cached
// here so the admin UI never scans on page load and public pages never scan.
model SeoScanRun {
  id          String    @id
  startedAt   DateTime
  finishedAt  DateTime?
  status      String
  triggeredBy String
  summary     Json
  findings    Json

  @@index([startedAt])
}

// PHASE D: outbound integration attempts (IndexNow submissions).
model SeoIntegrationLog {
  id          String   @id
  integration String
  action      String
  status      String
  httpStatus  Int?
  detail      String
  urls        Json
  createdAt   DateTime

  @@index([integration, createdAt])
}

// PHASE C: CMS settings (key/value). Allowed keys, validation and which keys
// may reach public pages are defined in server/settings.ts.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime
  updatedBy String
}

model AuditLog {
  id         String          @id
  // Free-text-ish actor identity, intentionally NOT a foreign key: real
  // audit rows already reference values that are not valid User ids
  // (e.g. "system-scheduler" for the publish daemon, "unknown" for failed
  // logins against a non-existent email) — a FK constraint here would break
  // existing, correct application behavior.
  userId     String
  userName   String
  action     String
  entityType AuditEntityType
  entityId   String
  timestamp  DateTime
  details    String
  // PHASE R (Spec §24.3): the changed fields only, before and after.
  // Secrets are never recorded (server/audit.ts redacts them).
  before     Json?
  after      Json?

  @@index([timestamp])
  @@index([userId])
  @@index([entityType, entityId])
}

// PHASE H: editor-managed FAQ shown at /faq/. Plain text only (no HTML);
// `status` is draft | published | archived, like other editorial content.
model FaqEntry {
  id           String   @id
  question     String
  answer       String
  displayOrder Int      @default(0)
  status       String   @default("draft")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  updatedBy    String
  // E5: NULL = the global /faq/ page; set = shown only on that Event's page.
  // Keyed by the stable Event id so slug/sport changes never orphan it.
  eventId      String?
  // PHASE R (v2.2 FAQ & Reader Questions): an entry belongs to at most ONE
  // context — an Article, an Event Edition, an Event or a Sport-level guide
  // (CHECK constraint "FaqEntry_single_context"). No context = site-wide.
  articleId    String?
  editionId    String?
  sportId      String?
  // Where the entry came from: "editor", "ai-suggestion" or "data-suggestion".
  // Suggestions are always created as drafts; publishing needs an editor.
  source       String   @default("editor")
  // Who published it (human approval record).
  approvedBy   String?
  approvedAt   DateTime?

  event   SportEvent?   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  article Article?      @relation(fields: [articleId], references: [id], onDelete: Restrict)
  edition EventEdition? @relation(fields: [editionId], references: [id], onDelete: Restrict)
  sport   Sport?        @relation(fields: [sportId], references: [id], onDelete: Restrict)

  @@index([status, displayOrder])
  @@index([eventId, status, displayOrder])
  @@index([articleId, status, displayOrder])
  @@index([editionId, status, displayOrder])
  @@index([sportId, status, displayOrder])
}

// PHASE R (Spec §19.5 / §25.5): aggregate internal search analytics. One row
// per UTC day and normalized query. No user, session, IP or device data.
model SearchQueryStat {
  day         DateTime @db.Date
  query       String
  searches    Int      @default(0)
  zeroResults Int      @default(0)

  @@id([day, query])
  @@index([day])
}

// PHASE R (Spec §25.6–25.8): real-user Core Web Vitals, aggregated per UTC
// day, page type, metric and device class. `histogram` counts samples per
// fixed bucket (server/rum.ts) so the 75th percentile can be computed
// without storing individual measurements.
model WebVitalStat {
  day       DateTime @db.Date
  pageType  String
  metric    String
  device    String
  samples   Int      @default(0)
  good      Int      @default(0)
  needsWork Int      @default(0)
  poor      Int      @default(0)
  histogram Int[]    @default([])

  @@id([day, pageType, metric, device])
  @@index([day])
}

// PHASE R (Spec §25.2): aggregate page views per UTC day and public path.
// Counted without cookies or identifiers; query strings are never stored.
model PageViewStat {
  day      DateTime @db.Date
  path     String
  pageType String
  views    Int      @default(0)

  @@id([day, path])
  @@index([day, pageType])
}

// PHASE R (Spec §17.2, §25.3–25.4): Search Console / Bing Webmaster data,
// stored exactly as the provider API returned it (never estimated).
// dimension: "date" | "query" | "page" | "country" | "device" | "searchAppearance".
model SearchPerformanceStat {
  source      String
  day         DateTime @db.Date
  dimension   String
  key         String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  @@id([source, day, dimension, key])
  @@index([source, dimension, day])
}

// PHASE R: latest provider snapshot that is not a daily series
// (Search Console sitemaps, Bing crawl/index stats). kind: "sitemaps" | "crawl".
model SearchEngineSnapshot {
  source    String
  kind      String
  fetchedAt DateTime
  data      Json

  @@id([source, kind])
}

// PHASE R (Spec §27): the migration sheet. One row per old-site URL. The
// inventory itself is owner input; this table holds the decisions, the new
// URL and the resulting redirect. decision: UNDECIDED | KEEP | REWRITE | MERGE | RETIRE.
model MigrationItem {
  id           String    @id
  oldUrl       String    @unique
  oldCategory  String    @default("")
  oldTitle     String    @default("")
  decision     String    @default("UNDECIDED")
  newCategory  String    @default("")
  newTitle     String    @default("")
  newUrl       String    @default("")
  // "pending" | "ok" | "error"; `validation` lists the problems found.
  checkStatus  String    @default("pending")
  validation   Json?
  redirectId   String?
  notes        String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  updatedBy    String

  @@index([decision])
  @@index([checkStatus])
}

// PHASE H: messages sent through the public contact form. Stored only —
// no e-mail is sent. No IP address or user agent is kept. `status` is
// open | resolved | spam; `readAt` NULL means unread.
model ContactMessage {
  id        String    @id
  name      String
  email     String
  subject   String
  message   String
  status    String    @default("open")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([status, readAt])
}

// PHASE F.1: Site Experience — one validated JSON document per public-site
// area (homepage, navigation, footer, announcements, blocks); see
// src/lib/siteExperience. `published` is what visitors see (NULL = built-in
// defaults); `draft` is the editors' working copy; `scheduled` goes live at
// `scheduledFor`.
model SiteExperience {
  area           String    @id
  draft          Json
  published      Json?
  scheduled      Json?
  scheduledFor   DateTime?
  version        Int       @default(0)
  draftUpdatedAt DateTime
  draftUpdatedBy String
  publishedAt    DateTime?
  publishedBy    String?
}

// PHASE PAGES: CMS-managed informational pages served at /{slug}/ (About,
// Privacy Policy, Terms, editorial policies …). The body uses the same
// allow-listed rich-text document as articles (src/lib/richText.ts); `content`
// is its derived plain text. `system` rows are the site's required pages:
// editable, but their slug is fixed and they cannot be unpublished or deleted.
// `template` adds the one non-text part a page may need (the contact form, or
// the Privacy Policy's disclosures generated from the live configuration).
model Page {
  id             String    @id
  slug           String    @unique
  title          String
  // Breadcrumb / footer label when shorter than the title.
  shortTitle     String?
  // Subtitle under the heading (tagline, "Last revised …").
  summary        String?
  body           Json
  content        String
  status         String    @default("draft")
  template       String    @default("standard")
  system         Boolean   @default(false)
  seoTitle       String?
  seoDescription String?
  noIndex        Boolean   @default(false)
  ogMediaId      String?
  // Media Library ids used in the body (Media Library usage / delete guard).
  mediaIds       String[]  @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  publishedAt    DateTime?
  createdBy      String
  updatedBy      String

  ogMedia MediaItem? @relation("PageOgMedia", fields: [ogMediaId], references: [id], onDelete: Restrict)

  @@index([status])
}

// PHASE AUTOSAVE: server-side editor working copies (autosave + recovery).
// Never rendered publicly and never a publishing state: the live
// Article/SportEvent/EventEdition/Page row changes only through its existing
// save/publish endpoints. `entityId` NULL = new content not yet created; such
// a draft is private to `ownerId`. For an existing item there is at most one
// shared working copy (unique kind+entityId; PostgreSQL treats NULLs as
// distinct, so new drafts are not limited). `revision` guards concurrent
// autosaves; `baseVersion` is the item's version when editing began, so a
// stale apply can be detected. `mediaIds` keeps referenced media from being
// deleted as unused.
model EditorDraft {
  id          String   @id
  kind        String
  entityId    String?
  ownerId     String
  title       String
  payload     Json
  baseVersion String?
  revision    Int      @default(1)
  mediaIds    String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([kind, entityId])
  @@index([ownerId])
  @@index([updatedAt])
}
