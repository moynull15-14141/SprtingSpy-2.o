// SportingSpy PostgreSQL Schema — PHASE 2
// ==========================================
// Modeled directly from the actual runtime shapes in data/db.json and the
// TypeScript domain types in src/types/index.ts — not from generic CMS
// assumptions. See PROJECT_BRAIN.md "Phase 2" for the migration writeup.
//
// Design notes:
// - Every model keeps its existing string `id` scheme (e.g. "sport-tennis",
//   "art-rg-2027-schedule") as the Prisma @id, so existing IDs migrate
//   unchanged and the API can keep returning the same id values.
// - Relationships use the SAME natural keys the current JSON code already
//   uses to join records (sportSlug, eventSlug, year) rather than inventing
//   surrogate foreign keys the app doesn't have today — this preserves the
//   actual current behavior/business rules exactly while still getting real
//   Postgres foreign-key + unique-constraint enforcement.
// - Nested structures that the app only ever reads/writes as a whole blob
//   (SEO metadata, quick facts, defending champions, structured tables,
//   references, featured/edition-year arrays) are stored as native Postgres
//   array or Json columns rather than being split into extra tables the
//   application never queries relationally — avoids unnecessary models.
// - MediaItem, AdSlotConfig, RedirectRule, AuditLog remain standalone,
//   matching their current disconnected/denormalized behavior in server.ts.

generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums (mirrors the TypeScript unions in src/types/index.ts) ──

enum Role {
  Admin
  Editor
  Author
  Reader
}

enum UserStatus {
  active
  inactive
}

enum ArticleStatus {
  draft
  preview
  scheduled
  published
  archived
}

enum ArticleReviewStatus {
  not_required
  draft
  in_review
  changes_requested
  approved
}

// Spec v1.1 §4.3. Phase A renamed "ongoing" -> "active" and added
// "archived" (migration 20260927000000_phase_a_foundation).
enum EditionStatus {
  upcoming
  active
  completed
  archived
}

enum CommentStatus {
  pending
  approved
  rejected
}

// ArticleType and MediaCreationType are deliberately plain, app-validated
// String columns rather than Prisma enums. Both TS unions contain values
// with spaces/ampersands ("Rules & Format", "How to Watch") that
// cannot be Prisma enum identifiers without an @map translation layer on
// every single read/write call site across server.ts. That translation
// buys no real integrity benefit here (these fields were never DB-enforced
// in the JSON version either — server.ts already validates/defaults them at
// the application layer), so a String column preserves the exact existing
// values and behavior with zero added translation risk.

enum AuditEntityType {
  Sport
  Event
  Edition
  Article
  Comment
  Setting
  User
  Author
  Redirect
  Faq
  ContactMessage
}

// ── Core domain hierarchy: Sport -> Event -> Edition -> Article ──

model Sport {
  id               String   @id
  slug             String   @unique
  name             String
  tagline          String
  description      String
  order            Int
  isVisible        Boolean  @default(true)
  featuredEventIds String[] @default([])
  colorTheme       String?
  heroImage        String?
  seo              Json
  // E2: optional validated definitions/terminology. NULL resolves to generic configuration.
  eventConfiguration Json?
  // Icon from the curated set in src/config/sportIcons.ts; null = suggested from the name.
  icon             String?

  events   SportEvent[]
  articles Article[]

  @@index([isVisible])
}

model SportEvent {
  id                 String  @id
  sportSlug          String
  slug               String
  name               String
  shortName          String
  description        String
  history            String?
  frequency          String?
  defaultVenue       String?
  defaultLocation    String?
  currentEditionYear Int?
  allEditionYears    Int[]   @default([])
  featured           Boolean @default(false)
  isVisible          Boolean @default(true)
  featuredImage      String?
  officialSourceUrl  String?
  eventType          String?
  seo                Json
  // E2: values only; definitions live on Sport.eventConfiguration.
  sportSpecificValues Json?

  sport    Sport          @relation(fields: [sportSlug], references: [slug])
  editions EventEdition[]

  // Matches the exact uniqueness the app already enforces in POST /api/events
  // ("Event '<slug>' already exists under sport '<sportSlug>'").
  @@unique([sportSlug, slug])
  @@index([sportSlug])
}

model EventEdition {
  id                 String        @id
  eventSlug          String
  sportSlug          String
  year               Int
  title              String
  startDate          String?
  endDate            String?
  venue              String?
  location           String?
  status             EditionStatus @default(upcoming)
  quickFacts         Json          @default("[]")
  prizeMoneyTotal    String?
  defendingChampions Json?
  qualificationInfo  String?
  participantsCount  Int?
  officialSourceUrl  String?
  description        String
  featuredImage      String?
  seo                Json

  event    SportEvent @relation(fields: [sportSlug, eventSlug], references: [sportSlug, slug])
  articles Article[]

  // Matches POST /api/editions's exact collision check.
  @@unique([sportSlug, eventSlug, year])
  @@index([sportSlug, eventSlug])
}

model Article {
  id                 String        @id
  slug               String
  title              String
  subtitle           String?
  sportSlug          String
  eventSlug          String?
  editionYear        Int?
  articleType        String        @default("Event Guide")
  excerpt            String
  content            String
  featuredImage      String
  authorId           String
  publishedAt        DateTime
  updatedAt          DateTime?
  scheduledFor       DateTime?
  status             ArticleStatus @default(draft)
  reviewStatus       ArticleReviewStatus @default(not_required)
  reviewerId         String?
  reviewComment      String?
  reviewSubmittedAt  DateTime?
  reviewDecidedAt    DateTime?
  reviewVersion      Int @default(0)
  reviewer           User? @relation("ArticleReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  readingTimeMinutes Int
  featured           Boolean       @default(false)
  tables             Json?
  references         Json?
  seo                Json
  // PHASE C: rich-text body (validated TipTap/ProseMirror JSON document).
  // When null the legacy plain-text `content` is rendered. `content` is
  // always kept as the plain-text projection (search, reading time).
  body               Json?
  // PHASE C: the featured image as a Media Library relation. `featuredImage`
  // (URL) is kept as the resolved fallback for legacy/URL-only images.
  featuredMediaId    String?
  // PHASE D: when an editor last confirmed the content is still accurate
  // (freshness review). Never changes updatedAt.
  reviewedAt         DateTime?
  // PHASE E: weighted full-text search document. A STORED generated column
  // computed by PostgreSQL from title/subtitle/type/sport/event/keywords/
  // excerpt/content (see migration 20260929090000_phase_e_search). Never
  // written by the application; read only through server/services/search.
  searchVector       Unsupported("tsvector")? @default(dbgenerated("(((setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, ((((((((COALESCE(subtitle, ''::text) || ' '::text) || COALESCE(\"articleType\", ''::text)) || ' '::text) || replace(COALESCE(\"sportSlug\", ''::text), '-'::text, ' '::text)) || ' '::text) || replace(COALESCE(\"eventSlug\", ''::text), '-'::text, ' '::text)) || ' '::text) || COALESCE(((seo -> 'keywords'::text))::text, ''::text))), 'B'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(excerpt, ''::text)), 'C'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(content, ''::text)), 'D'::\"char\"))"))

  sport         Sport          @relation(fields: [sportSlug], references: [slug])
  author        Author         @relation(fields: [authorId], references: [id])
  edition       EventEdition?  @relation(fields: [sportSlug, eventSlug, editionYear], references: [sportSlug, eventSlug, year])
  featuredMedia MediaItem?     @relation("ArticleFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: Restrict)
  bodyMedia     ArticleMedia[]
  comments      Comment[]

  // NOTE: true slug-collision scoping (sportSlug+eventSlug+editionYear+slug,
  // with JS `undefined === undefined` semantics for general articles) is
  // enforced in application code (server.ts), not by a DB unique constraint
  // here — Postgres treats NULL columns as distinct in unique constraints,
  // which would NOT match the app's existing JS equality behavior for
  // general (no event/edition) articles. See server.ts's article creation
  // handler for the actual collision check, preserved as-is.
  @@index([sportSlug])
  @@index([status])
  @@index([status, scheduledFor])
  @@index([reviewStatus, reviewerId])
  @@index([slug])
  @@index([authorId])
  @@index([featuredMediaId])
  @@index([status, publishedAt])
  @@index([searchVector], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], map: "Article_title_trgm_idx", type: Gin)
  @@index([excerpt(ops: raw("gin_trgm_ops"))], map: "Article_excerpt_trgm_idx", type: Gin)
}

// PHASE C: images referenced inside an article body (usage tracking).
// Maintained by the server on every article save.
model ArticleMedia {
  articleId String
  mediaId   String

  article Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media   MediaItem @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([articleId, mediaId])
  @@index([mediaId])
}

// ── Authors & Staff Identity (Phase 1 relationship preserved) ──

model Author {
  id           String  @id
  slug         String  @unique
  name         String
  roleTitle    String
  bio          String
  avatar       String
  twitter      String?
  email        String?
  articleCount Int?    @default(0)

  // Phase 1: links a public byline to the staff account permitted to edit
  // its articles. Nullable — many Author profiles have no staff login
  // (freelance/legacy credits). No onDelete cascade: deleting a User must
  // not delete their Author profile/byline (matches current app behavior,
  // which never deletes Authors when a User is deleted).
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  articles Article[]
}

model User {
  id           String     @id
  name         String
  email        String     @unique
  role         Role
  avatar       String
  joinedAt     DateTime
  updatedAt    DateTime?
  status       UserStatus @default(active)
  // Server-only. Never selected into any API response — see
  // server/db/users.ts's sanitizeUser() projection.
  passwordHash String

  authorProfile Author?
  assignedReviews Article[] @relation("ArticleReviewer")
  sessions      Session[]

  @@index([email])
  @@index([role, status])
}

// Phase 1: opaque-token sessions. Deleting the user cascades to their
// sessions, matching the existing manual `db.sessions = db.sessions.filter(...)`
// behavior on user deletion in server.ts exactly.
model Session {
  id        String   @id
  userId    String
  createdAt DateTime
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ── Comments (denormalized author fields preserved exactly as the JSON
// version stores them — no live join to User, so a comment keeps showing
// its author's name/avatar/role even if that User is later deleted, exactly
// matching current behavior) ──

model Comment {
  id         String        @id
  articleId  String
  userId     String
  userName   String
  userAvatar String?
  userRole   Role?
  content    String
  createdAt  DateTime
  status     CommentStatus @default(pending)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([status])
}

// ── Standalone collections (no relations in the current app — preserved
// disconnected, matching existing behavior exactly) ──

model MediaItem {
  id           String            @id
  title        String
  url          String
  altText      String
  caption      String?
  credit       String?
  source       String?
  license      String?
  creationType String  @default("Original")
  uploadedAt   DateTime
  fileSize     String?
  dimensions   String?

  // PHASE C: stored file + processing results (null for legacy URL-only items).
  storageKey      String?
  filename        String?
  mimeType        String?
  width           Int?
  height          Int?
  sizeBytes       Int?
  variants        Json?
  // PHASE C: Spec v1.1 §16 metadata.
  aiTool          String?
  humanEditing    String?
  copyrightReview String    @default("pending")
  updatedAt       DateTime?

  featuredIn Article[]      @relation("ArticleFeaturedMedia")
  bodyUsages ArticleMedia[]
}

model AdSlotConfig {
  id                   String  @id
  name                 String
  placementDescription String
  enabled              Boolean @default(false)
  sponsorName          String?
  bannerText           String?
  linkUrl              String?
  dimensions           String
  // PHASE F: who fills the slot. "house" = the sponsor/partner banner above
  // (no third party); "adsense" = a Google AdSense unit, rendered only with
  // advertising consent. providerSlotId = the provider's ad unit ID.
  provider             String  @default("house")
  providerSlotId       String?
  creativeId           String?
  creative             AdCreative? @relation(fields: [creativeId], references: [id], onDelete: Restrict)
  creativeAlt          String?
  creativeFit          String @default("contain")
}

model AdCreative {
  id              String @id
  title           String
  url             String
  storageKey      String @unique
  kind            String
  mimeType        String
  width           Int
  height          Int
  sizeBytes       Int
  durationSeconds Float?
  createdAt       DateTime @default(now())
  slots           AdSlotConfig[]
}

model RedirectRule {
  id         String    @id
  // PHASE C: one rule per source path (stored without trailing slash).
  sourceUrl  String    @unique
  targetUrl  String
  statusCode Int
  createdAt  DateTime
  isActive   Boolean   @default(true)
  // PHASE C: "manual" or "article-slug" (created automatically on URL change).
  origin     String    @default("manual")
  notes      String?
  updatedAt  DateTime?

  @@index([isActive])
}

// PHASE D: SEO rules engine. Rule logic lives in code (server/seo/rules.ts),
// keyed by `key`; everything an editor may tune without a rebuild —
// enabled, severity, applicable article types, thresholds/term lists — is here.
model SeoRule {
  id           String   @id
  key          String   @unique
  name         String
  description  String
  category     String
  targetType   String
  articleTypes String[] @default([])
  severity     String
  enabled      Boolean  @default(true)
  config       Json
  version      Int      @default(1)
  createdAt    DateTime
  updatedAt    DateTime
}

// PHASE D: one SEO Intelligence scan (admin-triggered). Findings are cached
// here so the admin UI never scans on page load and public pages never scan.
model SeoScanRun {
  id          String    @id
  startedAt   DateTime
  finishedAt  DateTime?
  status      String
  triggeredBy String
  summary     Json
  findings    Json

  @@index([startedAt])
}

// PHASE D: outbound integration attempts (IndexNow submissions).
model SeoIntegrationLog {
  id          String   @id
  integration String
  action      String
  status      String
  httpStatus  Int?
  detail      String
  urls        Json
  createdAt   DateTime

  @@index([integration, createdAt])
}

// PHASE C: CMS settings (key/value). Allowed keys, validation and which keys
// may reach public pages are defined in server/settings.ts.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime
  updatedBy String
}

model AuditLog {
  id         String          @id
  // Free-text-ish actor identity, intentionally NOT a foreign key: real
  // audit rows already reference values that are not valid User ids
  // (e.g. "system-scheduler" for the publish daemon, "unknown" for failed
  // logins against a non-existent email) — a FK constraint here would break
  // existing, correct application behavior.
  userId     String
  userName   String
  action     String
  entityType AuditEntityType
  entityId   String
  timestamp  DateTime
  details    String

  @@index([timestamp])
  @@index([userId])
  @@index([entityType, entityId])
}

// PHASE H: editor-managed FAQ shown at /faq/. Plain text only (no HTML);
// `status` is draft | published | archived, like other editorial content.
model FaqEntry {
  id           String   @id
  question     String
  answer       String
  displayOrder Int      @default(0)
  status       String   @default("draft")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  updatedBy    String

  @@index([status, displayOrder])
}

// PHASE H: messages sent through the public contact form. Stored only —
// no e-mail is sent. No IP address or user agent is kept. `status` is
// open | resolved | spam; `readAt` NULL means unread.
model ContactMessage {
  id        String    @id
  name      String
  email     String
  subject   String
  message   String
  status    String    @default("open")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([status, readAt])
}

// PHASE F.1: Site Experience — one validated JSON document per public-site
// area (homepage, navigation, footer, announcements, blocks); see
// src/lib/siteExperience. `published` is what visitors see (NULL = built-in
// defaults); `draft` is the editors' working copy; `scheduled` goes live at
// `scheduledFor`.
model SiteExperience {
  area           String    @id
  draft          Json
  published      Json?
  scheduled      Json?
  scheduledFor   DateTime?
  version        Int       @default(0)
  draftUpdatedAt DateTime
  draftUpdatedBy String
  publishedAt    DateTime?
  publishedBy    String?
}
